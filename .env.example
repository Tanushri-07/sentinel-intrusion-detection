# Sentinel Intrusion Detection — Environment Configuration Example
# Copy this file to .env and adjust values as needed.

# Detection & Ban Thresholds
BAN_THRESHOLD=10
WINDOW_SECONDS=60
BAN_DURATION_SECONDS=300

# File Paths & Database
LOG_FILE_PATH=portal_auth.log
DATABASE_URL=sqlite:///./sentinel.db

# Optional Admin API Authentication
ADMIN_API_KEY=

# Optional AI Threat Explainer
# System functions fully without an AI key. Set to enable LLM threat summaries.
AI_API_KEY=
